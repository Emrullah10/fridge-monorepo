NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fridge:fridge@localhost:5432/fridge

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

UPLOADS_DIR=uploads

# Tüm AI özellikleri (fiş tarama, tarif, şef, alışveriş) Z.ai üzerinden çalışır.
# z.ai adresinden API key alınır + hesaba kredi yüklenmesi gerekir (ön-ödemeli,
# bakiye biterse istekler durur — otomatik ek çekim yok). Varsayılan model
# glm-4.6 ($0.60/$2.20 per 1M token), thinking kapalı (bkz. infrastructure/ai/zai.js).
# Ücretsiz modeller (glm-4.7-flash/glm-4.5-flash) canlıda denendi, üretim için
# yeterince hızlı/güvenilir bulunmadı — bkz. docs/ZAI_MIGRATION_PLAN.md.
ZAI_API_KEY=your-zai-api-key-here
ZAI_MODEL=glm-4.6
# İsteğe bağlı model ezmeleri:
# ZAI_RECIPE_MODEL=glm-4.6
# ZAI_SHOPPING_MODEL=glm-4.6
# ZAI_CHEF_MODEL=glm-4.6

# AI özelliklerini açma/kapama anahtarları (varsayılan: true).
# false yapılırsa ilgili uç noktalar 503 döner.
RECIPE_AI_ENABLED=true
SHOPPING_AI_ENABLED=true
CHEF_AI_ENABLED=true

SCAN_WORKER_INTERVAL_MS=1000
RETENTION_CLEANUP_INTERVAL_MS=86400000

# CORS_ALLOWED_ORIGINS=https://app.example.com,https://example.com

# FCM_ENABLED=false ya da kimlik bilgisi eksikse container no-op adaptöre
# düşer — push hiçbir isteği asla 500'e düşürmez.
FCM_ENABLED=false
# Tercih 1 (prod/PM2): dosya yolu, repo dışında, chmod 600.
# FCM_SERVICE_ACCOUNT_PATH=/home/emrullah/secrets/fridge-fcm.json
# Tercih 2: JSON'ın base64'ü tek env değişkeninde.
# FCM_SERVICE_ACCOUNT_BASE64=
# FCM_PROJECT_ID=fridge-xxxxx

# Şifremi unuttum — Resend ile 6 haneli kod gönderimi. Key yoksa container
# no-op mailer'a düşer (boot patlamaz), kod dev'de konsola basılır.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Fridge <onboarding@resend.dev>
# PASSWORD_RESET_TTL_MINUTES=15

# Mobil açılışta GET /app-config ile karşılaştırır.
# APP_LATEST_VERSION: PLAY_SERVICE_ACCOUNT_* ayarlıysa hiç kullanılmaz —
# gerçek sürüm doğrudan Play Store'dan (production track) okunur. Sadece
# service account kurulu değilse veya Play API'ye erişilemezse fallback
# olarak devreye girer. Elle güncellemene gerek KALMAMALI.
# APP_LATEST_VERSION=1.0.0
# APP_MIN_SUPPORTED_VERSION=1.0.0
# APP_STORE_URL=https://play.google.com/store/apps/details?id=com.fridge.fridge_mobil

# Play Console > Setup > API access'te "View app information (read-only)"
# izniyle davet edilmiş bir service account — /app-config'in latestVersion'ı
# artık buradan (gerçek yayınlanan sürüm) geliyor, ayrı APP_LATEST_VERSION
# elle güncellemesi gerekmiyor. FCM_SERVICE_ACCOUNT_* ile aynı ikili desen
# (path local'de, base64 prod'da).
# PLAY_SERVICE_ACCOUNT_PATH=/home/emrullah/secrets/play-version-reader.json
# PLAY_SERVICE_ACCOUNT_BASE64=
# PLAY_PACKAGE_NAME=com.fridge.fridge_mobil

# iOS eşdeğeri — GET /app-config?platform=ios buradan servis edilir. iTunes
# Lookup public API kimlik bilgisi gerektirmediği için service account yok.
# App Store'da henüz yayın yoksa (TestFlight-only) adaptör null döner ve
# APP_LATEST_VERSION_IOS fallback'ine düşülür (o da yoksa APP_LATEST_VERSION'a).
# APP_STORE_URL_IOS=https://apps.apple.com/app/id0000000000
# APP_LATEST_VERSION_IOS=1.0.0
# APP_MIN_SUPPORTED_VERSION_IOS=1.0.0
# IOS_BUNDLE_ID=com.fridge.fridgeMobil

# Plan/kota limitlerini uygulama sürümü çıkarmadan ayarlamak için —
# kısmi bir JSON objesi yeterli (bkz. domain/plans.js buildPlanLimits()).
# PLAN_LIMITS_JSON={"free":{"ai":{"receipt":5}}}

# RevenueCat webhook'u doğrulamak için paylaşılan sır — RC Dashboard >
# Project Settings > Webhooks > "Authorization Header Value" ile AYNI
# değer olmalı (biz "Bearer <secret>" gibi bir format zorlamıyoruz, RC'nin
# gönderdiği ham Authorization header değerini birebir karşılaştırıyoruz).
# Boş bırakılırsa webhook ucu TÜM istekleri 503 ile reddeder (fail-closed).
# REVENUECAT_WEBHOOK_SECRET=
