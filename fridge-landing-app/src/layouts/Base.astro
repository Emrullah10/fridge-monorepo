---
import '@styles/global.scss';
import { Font } from 'astro:assets';

/**
 * @typedef {Object} Props
 * @property {string} title
 * @property {string} description
 * @property {'tr'|'en'} [lang]
 * @property {string} [ogImage]
 */

const { title, description, lang = 'tr', ogImage = '/og/default.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#096444" />
    {/* Site kendi koyu temasına sahip: tarayıcının zorla karanlık modu (Chrome/Brave auto-dark)
       ve Dark Reader gradyan yazıları (background-clip:text) görünmez yapıyordu. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="darkreader-lock" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Elde" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Sadece 700 (h1/başlıklar, LCP elementi) preload edilir — preload'un
       varsayılanı (true) 2 subset × 3 ağırlık = 6 dosyayı önceden indirtiyor,
       bu da ilk boyayı geciktirip /ekranlar'da LCP bütçesini (3000ms) aşırdı. */}
    <Font cssVariable="--font-inter" preload={[{ weight: 700 }]} />
    <script is:inline>
      // Tema flash'ını önlemek için ilk boyamadan önce çalışır.
      (function () {
        try {
          var stored = localStorage.getItem('fridge-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>
    <div class="atmosphere-grid" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      // Kademeli beliriş + bento spotlight. JS yoksa/hareket kısıtlıysa her şey görünür kalır.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.reveal');
        if (!reduce && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('js');
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          els.forEach(function (el) { io.observe(el); });
        }
        if (!reduce && window.matchMedia('(hover: hover)').matches) {
          document.querySelectorAll('.spotlight').forEach(function (el) {
            el.addEventListener('pointermove', function (ev) {
              var r = el.getBoundingClientRect();
              el.style.setProperty('--mx', (ev.clientX - r.left) + 'px');
              el.style.setProperty('--my', (ev.clientY - r.top) + 'px');
            });
          });
        }
      })();
    </script>
  </body>
</html>
