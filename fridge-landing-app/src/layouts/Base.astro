---
import '@styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

/**
 * @typedef {Object} Props
 * @property {string} title
 * @property {string} description
 * @property {'tr'|'en'} [lang]
 * @property {string} [ogImage]
 */

const { title, description, lang = 'tr', ogImage = '/og/default.png' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload />
    <ClientRouter />
    <script is:inline>
      // Boyamadan önce çalışması gereken TEK bloklayıcı script: tema (karanlık
      // varsayılan, saklanmış 'light' tercihine izin verilir) + hareket
      // katmanı (`data-motion`) burada birlikte çözülür — plan §"Kod bölme"
      // bunu tek satırlık kapı olarak tanımlıyor.
      (function () {
        try {
          var stored = localStorage.getItem('fridge-theme');
          // Koyu-öncelikli: yalnızca açıkça 'light' saklanmışsa açık temaya izin
          // verilir, aksi halde (kayıt yok veya 'dark') karanlık kalır.
          if (stored === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }

        try {
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var narrow = window.innerWidth < 900 || window.matchMedia('(pointer: coarse)').matches;
          var cores = navigator.hardwareConcurrency;
          var mem = navigator.deviceMemory;
          var lowPower = (cores && cores < 4) || (mem && mem < 4);
          var saveData = !!(navigator.connection && navigator.connection.saveData);
          var tier = reduced ? 'still' : (narrow || lowPower || saveData ? 'lite' : 'full');
          document.documentElement.setAttribute('data-motion', tier);
        } catch (e) {
          document.documentElement.setAttribute('data-motion', 'still');
        }
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
