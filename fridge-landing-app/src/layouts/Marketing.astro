---
import Base from '@layouts/Base.astro';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import Atmosphere from '@components/site/Atmosphere.astro';

/**
 * @typedef {Object} Props
 * @property {string} title
 * @property {string} description
 * @property {'tr'|'en'} [locale]
 * @property {string} [ogImage]
 */

const { title, description, locale = 'tr', ogImage } = Astro.props;
---
<Base title={title} description={description} lang={locale} ogImage={ogImage}>
  <Atmosphere />
  <Header locale={locale} />
  <!--
    DOM zorunluluğu (bkz. plan "Kabuk ameliyatı"): <body> → #smooth-wrapper →
    #smooth-content. ScrollSmoother SADECE `full` katmanında kurulur
    (src/lib/motion/runtime.js); `lite`/`still`'de bu iki div normal akan
    kutulardır (transform uygulanmaz), bölümler onunla da onsuz da aynı
    çalışır çünkü ScrollTrigger umursamaz. Header/Footer/Atmosphere bu
    wrapper'ın DIŞINDA kardeş — fixed/sticky buranın içinde ölürdü.
    Wrapper/content transition:persist ALMAZ (plan): sayfa geçişinde
    yeniden kurulmalılar, Header/Footer/Atmosphere ise korunur.
  -->
  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </div>
</Base>

<style is:global>
  #smooth-wrapper {
    overflow: hidden;
    position: relative;
  }
  /* Header fixed olduğu için içerik altında boşluk bırakılır — Header'ın
     gerçek yüksekliği ~64-72px civarı, güvenli pay ile. */
  #smooth-content > main {
    padding-top: 72px;
  }
</style>
