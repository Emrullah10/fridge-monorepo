---
import Marketing from '@layouts/Marketing.astro';
import { marketingDict } from '@lib/i18n';
import Hero from '@components/home/Hero.astro';
import ActScan from '@components/home/ActScan.astro';
import ActParse from '@components/home/ActParse.astro';
import ActSort from '@components/home/ActSort.astro';
import ActMoney from '@components/home/ActMoney.astro';
import FeatureStrip from '@components/home/FeatureStrip.astro';
import ScreenMarquee from '@components/home/ScreenMarquee.astro';
import MetricsBand from '@components/home/MetricsBand.astro';
import FinalCta from '@components/home/FinalCta.astro';

const locale = 'tr';
const t = marketingDict[locale].home;

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fridge',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  description: 'Market fişini tara, ürünler envanterine düşsün. Buzdolabı, dondurucu, kiler; ne biriktirdiğini ne israf ettiğini gör.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: 'tr',
};

const [scanAct, parseAct, sortAct, moneyAct] = t.acts;
---
<Marketing
  title="Fridge — Fişi tara, gerisini Fridge halletsin"
  description="Market fişini tara, ürünler envanterine düşsün. Buzdolabı, dondurucu, kiler; ne biriktirdiğini ne israf ettiğini gör."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

  <Hero t={t.hero} locale={locale} />
  <ActScan t={scanAct} locale={locale} />
  <ActParse t={parseAct} locale={locale} />
  <ActSort t={sortAct} locale={locale} />
  <ActMoney t={moneyAct} locale={locale} />

  <FeatureStrip features={t.features} locale={locale} />
  <ScreenMarquee locale={locale} />
  <MetricsBand heading={t.metrics.heading} locale={locale} />
  <FinalCta t={t.finalCta} />
</Marketing>

<script>
  // Kod bölme kapısı: GSAP yalnızca `/` üzerinde ve yalnızca `still`
  // olmayan katmanlarda indirilir (bkz. plan "Kod bölme" — is:inline
  // import'u çözmez, bu yüzden paketlenmiş <script> kullanılır).
  const tier = document.documentElement.getAttribute('data-motion');
  if (tier !== 'still') {
    import('../scripts/home.js');
  }
</script>
