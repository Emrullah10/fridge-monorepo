---
import Marketing from '@layouts/Marketing.astro';
import { marketingDict } from '@lib/i18n';
import Hero from '@components/home/Hero.astro';

const locale = 'tr';
const t = marketingDict[locale].home;

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fridge',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  description: 'Market fişini tara, ürünler envanterine düşsün. Buzdolabı, dondurucu, kiler; ne biriktirdiğini ne israf ettiğini gör.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: 'tr',
};
---
<Marketing
  title="Fridge — Fişi tara, gerisini Fridge halletsin"
  description="Market fişini tara, ürünler envanterine düşsün. Buzdolabı, dondurucu, kiler; ne biriktirdiğini ne israf ettiğini gör."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

  <Hero t={t.hero} locale={locale} />

  <!--
    Faz 3 durağı: yalnızca hero hareketi kuruldu (bkz. plan "En riskli
    altyapı dört bölüm kurulmadan tek bölümde kanıtlanır"). Bölüm 1-4 +
    film sonrası Faz 4-5'te eklenecek.
  -->
</Marketing>

<script>
  // Kod bölme kapısı: GSAP yalnızca `/` üzerinde ve yalnızca `still`
  // olmayan katmanlarda indirilir (bkz. plan "Kod bölme" — is:inline
  // import'u çözmez, bu yüzden paketlenmiş <script> kullanılır).
  const tier = document.documentElement.getAttribute('data-motion');
  if (tier !== 'still') {
    import('../scripts/home.js');
  }
</script>
