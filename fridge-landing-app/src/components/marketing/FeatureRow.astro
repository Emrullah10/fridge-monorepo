---
/**
 * @typedef {Object} Props
 * @property {string} icon
 * @property {string} title
 * @property {string} body
 * @property {string} [href]
 * @property {string} [linkText]
 */
const { icon, title, body, href, linkText } = Astro.props;
---
<div class="feature-row">
  <div class="feature-row__icon" aria-hidden="true">{icon}</div>
  <div class="feature-row__body">
    <h3 class="feature-row__title">{title}</h3>
    <p class="feature-row__text">{body}</p>
    {href && <a href={href} class="feature-row__link">{linkText ?? 'Detaylar →'}</a>}
  </div>
</div>

<style>
  .feature-row {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    background: var(--surface-container-low);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }
  .feature-row__icon {
    font-size: 32px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-container);
    border-radius: var(--radius-storage-icon);
    flex-shrink: 0;
  }
  .feature-row__title {
    margin: 0 0 var(--space-xs);
    font-size: var(--fs-h3);
  }
  .feature-row__text {
    margin: 0;
    color: var(--on-surface-variant);
  }
  .feature-row__link {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--primary);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    font-size: var(--fs-small);
  }
  .feature-row__link:hover {
    text-decoration: underline;
  }
</style>
