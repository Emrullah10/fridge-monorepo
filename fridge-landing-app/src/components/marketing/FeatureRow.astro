---
/**
 * @typedef {Object} Props
 * @property {string} [icon] - emoji (geriye dönük uyumluluk). Verilmezse
 *   `icon` named slot kullanılır — SVG ikon bileşenleri için (bkz. index.astro).
 * @property {string} title
 * @property {string} body
 * @property {string} [href]
 * @property {string} [linkText]
 * @property {'md'|'lg'} [size] - bento'da lg: geniş kart, preview slot'u gösterilir
 */
const { icon, title, body, href, linkText, size = 'md' } = Astro.props;
---
<div class:list={['feature-row', 'spotlight', `feature-row--${size}`]}>
  <div class="feature-row__icon" aria-hidden="true">
    {icon ? icon : <slot name="icon" />}
  </div>
  <div class="feature-row__body">
    <h3 class="feature-row__title">{title}</h3>
    <p class="feature-row__text">{body}</p>
    {href && <a href={href} class="feature-row__link">{linkText ?? 'Detaylar →'}</a>}
  </div>
  <div class="feature-row__preview" aria-hidden="true" inert><slot name="preview" /></div>
</div>

<style>
  .feature-row {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    background: var(--shell-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--shell-card-border);
    box-shadow: var(--shell-shadow-sm);
    border-radius: var(--radius-logo);
    padding: var(--space-lg);
    transition: transform var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard);
  }
  .feature-row:hover {
    transform: translateY(-2px);
    border-color: var(--shell-card-hover-border);
    box-shadow: var(--shell-shadow-md);
  }
  .feature-row__icon {
    font-size: 32px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--shell-tint);
    border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
    border-radius: var(--radius-storage-icon);
    flex-shrink: 0;
    color: var(--primary);
  }
  .feature-row__icon :global(svg) {
    width: 28px;
    height: 28px;
  }
  .feature-row__body {
    position: relative;
    z-index: 1;
  }
  .feature-row__preview {
    display: none;
  }
  .feature-row--lg {
    flex-direction: column;
    justify-content: space-between;
    min-height: 360px;
  }
  .feature-row--lg .feature-row__preview {
    display: block;
    width: 200px;
    margin: var(--space-md) auto -140px;
    transform: rotate(-4deg);
    transition: transform var(--dur-slow) var(--ease-standard);
  }
  .feature-row--lg:hover .feature-row__preview {
    transform: rotate(0deg) translateY(-8px);
  }
  .feature-row__title {
    margin: 0 0 var(--space-xs);
    font-size: var(--fs-h3);
  }
  .feature-row__text {
    margin: 0;
    color: var(--on-surface-variant);
  }
  .feature-row__link {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--primary);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    font-size: var(--fs-small);
  }
  .feature-row__link:hover {
    text-decoration: underline;
  }
</style>
