---
/**
 * @typedef {Object} Props
 * @property {string} eyebrow
 * @property {string} title
 * @property {string} [lead]
 * @property {'left'|'center'} [align]
 */
const { eyebrow, title, lead, align = 'center' } = Astro.props;
---
<div class:list={['section-heading', `section-heading--${align}`]}>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 class="section-heading__title">{title}</h2>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }
  .section-heading--center {
    align-items: center;
    text-align: center;
  }
  .section-heading__eyebrow {
    color: var(--primary);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--fs-small);
    margin: 0;
  }
  .section-heading__title {
    font-size: var(--fs-h2);
    margin: 0;
  }
  .section-heading__lead {
    color: var(--on-surface-variant);
    font-size: var(--fs-lead);
    max-width: 60ch;
    margin: 0;
  }
</style>
