---
/**
 * @typedef {Object} Props
 * @property {string} value
 * @property {string} label
 * @property {'neutral'|'good'|'bad'} [tone]
 */
const { value, label, tone = 'neutral' } = Astro.props;
---
<div class:list={['stat-tile', 'reveal', `stat-tile--${tone}`]}>
  <p class="stat-tile__value">{value}</p>
  <p class="stat-tile__label">{label}</p>
</div>

<style>
  .stat-tile {
    position: relative;
    overflow: hidden;
    background: var(--shell-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--shell-card-border);
    box-shadow: var(--shell-shadow-sm);
    border-radius: var(--radius-card);
    padding: var(--space-xl) var(--space-lg);
    text-align: center;
  }
  .stat-tile::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--shell-accent-gradient);
  }
  .stat-tile--bad::before {
    background: var(--error);
  }
  .stat-tile__value {
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--space-xs);
    color: var(--on-surface);
  }
  .stat-tile--good .stat-tile__value {
    color: var(--primary);
  }
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .stat-tile--good .stat-tile__value {
      background: var(--shell-text-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }
  .stat-tile--bad .stat-tile__value {
    color: var(--error);
  }
  .stat-tile__label {
    margin: 0;
    color: var(--on-surface-variant);
    font-size: var(--fs-small);
  }
</style>
