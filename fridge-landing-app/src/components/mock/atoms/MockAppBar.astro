---
// DESIGN_SPEC §9.1: sola dayalı başlık, 20px/600.
import Icon from '@components/site/Icon.astro';

/**
 * @typedef {Object} Props
 * @property {string} title
 * @property {boolean} [showBack]
 */
const { title, showBack = false } = Astro.props;
---
<div class="mock-appbar">
  {showBack && <span class="mock-appbar__back"><Icon name="arrow_back" size={20} /></span>}
  <p class="mock-appbar__title" role="heading" aria-level="2">{title}</p>
</div>

<style>
  .mock-appbar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--surface);
  }
  .mock-appbar__back {
    color: var(--on-surface);
    display: flex;
  }
  .mock-appbar__title {
    margin: 0;
    font-size: var(--fs-appbar-title);
    font-weight: var(--fw-semibold);
    color: var(--on-surface);
    text-align: left;
  }
</style>
