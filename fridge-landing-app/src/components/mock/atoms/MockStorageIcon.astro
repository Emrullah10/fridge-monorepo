---
// DESIGN_SPEC §1.2: bölüm renkleri sabit, elle sabitlenmiş, %15 zemin + %100 ikon.
import Icon from '@components/site/Icon.astro';

/**
 * @typedef {Object} Props
 * @property {'fridge'|'freezer'|'pantry'|'other'} kind
 * @property {number} [size]
 */
const { kind, size = 48 } = Astro.props;

const meta = {
  fridge: { color: 'var(--storage-fridge)', icon: 'kitchen' },
  freezer: { color: 'var(--storage-freezer)', icon: 'ac_unit' },
  pantry: { color: 'var(--storage-pantry)', icon: 'inventory_2' },
  other: { color: 'var(--storage-other)', icon: 'inventory_2' },
}[kind];
---
<div
  class="mock-storage-icon"
  style={`--icon-color: ${meta.color}; width: ${size}px; height: ${size}px;`}
>
  <Icon name={meta.icon} size={Math.round(size * 0.55)} />
</div>

<style>
  .mock-storage-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-storage-icon);
    background: color-mix(in srgb, var(--icon-color) 15%, transparent);
    color: var(--icon-color);
  }
</style>
