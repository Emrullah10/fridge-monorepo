---
// Kaynak: fridge-mobil/lib/features/household/presentation/household_list_screen.dart
import PhoneFrame from '@components/mock/PhoneFrame.astro';
import MockAppBar from '@components/mock/atoms/MockAppBar.astro';
import MockEmptyState from '@components/mock/atoms/MockEmptyState.astro';
import MockFab from '@components/mock/atoms/MockFab.astro';
import Icon from '@components/site/Icon.astro';
import { getSeed } from '@seed/index';

/**
 * @typedef {Object} Props
 * @property {'full'|'empty'} [seedMode]
 * @property {'light'|'dark'} [theme]
 * @property {'tr'|'en'} [locale]
 */
const { seedMode = 'full', theme = 'light', locale = 'tr' } = Astro.props;
const seed = getSeed(seedMode);
const households = seed.household.name ? [seed.household] : [];
---
<PhoneFrame theme={theme} label="Alanlarım">
  <MockAppBar title={locale === 'tr' ? 'Alanlarım' : 'My spaces'} />
  <div class="hh-list">
    {households.length === 0 ? (
      <MockEmptyState
        icon="home"
        title={locale === 'tr' ? 'Henüz bir alanın yok' : "You don't have a space yet"}
        description={locale === 'tr' ? 'Yeni bir ev oluştur veya davet koduyla katıl.' : 'Create a new household or join with an invite code.'}
      />
    ) : (
      households.map((hh) => (
        <div class="hh-card">
          <div class="hh-card__icon"><Icon name="home" size={24} /></div>
          <div class="hh-card__body">
            <p class="hh-card__name">{hh.name}</p>
            <p class="hh-card__meta">{hh.members.length} {locale === 'tr' ? 'üye' : 'members'} · {hh.storageLocations.length} {locale === 'tr' ? 'bölüm' : 'sections'}</p>
          </div>
        </div>
      ))
    )}
  </div>
  <MockFab icon="add" ariaLabel={locale === 'tr' ? 'Yeni Ev' : 'New household'} />
  <MockFab icon="key" secondary ariaLabel={locale === 'tr' ? 'Davet Koduyla Katıl' : 'Join with invite code'} />
</PhoneFrame>

<style>
  .hh-list {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .hh-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--surface-container-low);
    border-radius: var(--radius-card);
    padding: var(--space-md);
  }
  .hh-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-storage-icon);
    background: var(--primary-container);
    color: var(--on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hh-card__name {
    margin: 0;
    font-weight: var(--fw-semibold);
    color: var(--on-surface);
  }
  .hh-card__meta {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--on-surface-variant);
  }
</style>
