---
// Kaynak: fridge-mobil/lib/features/auth/presentation/welcome_screen.dart
import PhoneFrame from '@components/mock/PhoneFrame.astro';
import Icon from '@components/site/Icon.astro';

/**
 * @typedef {Object} Props
 * @property {'light'|'dark'} [theme]
 * @property {'tr'|'en'} [locale]
 */
const { theme = 'light', locale = 'tr' } = Astro.props;
---
<PhoneFrame theme={theme} label="Karşılama">
  <div class="welcome-screen">
    <div class="welcome-screen__logo"><Icon name="kitchen" size={36} /></div>
    <p class="welcome-screen__title">Fridge</p>
    <p class="welcome-screen__subtitle">
      {locale === 'tr' ? 'Mutfağının dijital defteri' : "Your kitchen's digital ledger"}
    </p>
    <div class="welcome-screen__actions">
      <button class="btn btn--primary" type="button">{locale === 'tr' ? 'Giriş Yap' : 'Log in'}</button>
      <button class="btn btn--outlined" type="button">{locale === 'tr' ? 'Kayıt Ol' : 'Sign up'}</button>
    </div>
  </div>
</PhoneFrame>

<style>
  .welcome-screen {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }
  .welcome-screen__logo {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-logo);
    background: var(--primary-container);
    color: var(--on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
  }
  .welcome-screen__title {
    font-size: var(--fs-headline);
    font-weight: var(--fw-bold);
    color: var(--on-surface);
    margin: 0;
  }
  .welcome-screen__subtitle {
    color: var(--on-surface-variant);
    font-size: var(--fs-body);
    margin: 0 0 var(--space-lg);
  }
  .welcome-screen__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }
</style>
